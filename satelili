rednet.open("right") -- Oder "left" / "back", wo dein Modem ist

local x, y, z = 0, 0, 0

-- INITIALER START: HOCHFLIEGEN
print("Betanke Turtle...")
turtle.select(1)
turtle.refuel() -- Frisst Kohle aus Slot 1

print("Hebe ab...")
for i = 1, 10 do -- Fliegt 10 Bloecke hoch
    if turtle.up() then 
        y = y + 1 
    else
        print("Blockiert!")
    end
end

while true do
    -- Zufällige Bewegung
    local r = math.random(1, 4)
    if r == 1 then if turtle.forward() then x = x + 1 end
    elseif r == 2 then if turtle.back() then x = x - 1 end
    elseif r == 3 then turtle.turnLeft()
    elseif r == 4 then turtle.turnRight() end

    -- DATEN SENDEN
    local status = {
        posX = x,
        posY = y,
        posZ = z,
        fuel = turtle.getFuelLevel()
    }
    
    -- Wir senden es an ALLE mit dem Protokoll "SAT_DATA"
    rednet.broadcast(status, "SAT_DATA")
    print("Sende: X:"..x.." Y:"..y.." F:"..status.fuel)
    
    sleep(1) -- Warte kurz
end
