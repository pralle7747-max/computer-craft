-- SATELLITEN-TURTLE
rednet.open("right") -- Modem-Seite (meistens rechts)

local x, y, z = 0, 0, 0

-- 1. TANKEN & START
print("Status: Betanken...")
turtle.select(1)
turtle.refuel() -- Nimmt Kohle aus Slot 1

print("Status: Abheben...")
for i = 1, 15 do -- Fliegt 15 Blöcke hoch
    if turtle.up() then y = y + 1 end
end

-- 2. HAUPTSCHLEIFE
while true do
    -- Ein bisschen bewegen (Random Orbit)
    local r = math.random(1, 4)
    if r == 1 then if turtle.forward() then x = x + 1 end
    elseif r == 2 then if turtle.back() then x = x - 1 end
    elseif r == 3 then turtle.turnLeft()
    elseif r == 4 then turtle.turnRight() end

    -- DATEN SENDEN
    local data = {
        posX = x,
        posY = y,
        posZ = z,
        fuel = turtle.getFuelLevel()
    }
    
    rednet.broadcast(data, "SAT_UPDATE")
    print("Gesendet: X:"..x.." F:"..data.fuel)

    -- WARTEZEIT (Hier kannst du die Sekunden einstellen)
    -- 120 fuer 2 Minuten, 10 fuer schnelles Update
    sleep(10) 
end
