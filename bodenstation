rednet.open("back") -- Modem-Seite (meistens hinten)
local mon = peripheral.find("monitor")

if mon then
    mon.setTextScale(1)
end

local function updateDisplay(data)
    local target = mon or term
    target.setBackgroundColor(colors.black)
    target.clear()
    target.setCursorPos(1,1)
    
    target.setTextColor(colors.yellow)
    target.write("=== SAT-STATUS ===")
    
    target.setTextColor(colors.white)
    target.setCursorPos(1,3)
    target.write("Position: X:"..data.posX.." Y:"..data.posY.." Z:"..data.posZ)
    
    target.setCursorPos(1,5)
    target.setTextColor(data.fuel < 100 and colors.red or colors.lime)
    target.write("Fuel: " .. data.fuel)
    
    target.setCursorPos(1,7)
    target.setTextColor(colors.lightGray)
    target.write("Letztes Update: " .. textutils.formatTime(os.time(), true))
end

term.clear()
print("Warte auf Satelliten-Daten...")

while true do
    -- Warte auf Nachricht mit dem Protokoll "SAT_DATA"
    local id, msg, protocol = rednet.receive("SAT_DATA")
    
    if protocol == "SAT_DATA" and type(msg) == "table" then
        updateDisplay(msg)
    end
end
