-- BÜRO MONITOR
rednet.open("back") -- Modem-Seite am PC prüfen!
local mon = peripheral.find("monitor")

if mon then mon.setTextScale(1) end

local function updateScreen(d)
    local t = mon or term
    t.setBackgroundColor(colors.black)
    t.clear()
    
    t.setCursorPos(1,1)
    t.setTextColor(colors.yellow)
    t.write("=== SAT-SCANNER ===")
    
    t.setTextColor(colors.white)
    t.setCursorPos(1,3)
    t.write("KOORDINATEN:")
    t.setCursorPos(1,4)
    t.setTextColor(colors.lime)
    t.write("X: "..d.posX.." Y: "..d.posY.." Z: "..d.posZ)
    
    t.setTextColor(colors.white)
    t.setCursorPos(1,6)
    t.write("ENERGIE (FUEL):")
    t.setCursorPos(1,7)
    t.setTextColor(d.fuel < 200 and colors.red or colors.orange)
    t.write(d.fuel .. " Einheiten")
    
    t.setCursorPos(1,9)
    t.setTextColor(colors.gray)
    t.write("Letzter Ping: "..textutils.formatTime(os.time(), true))
end

term.clear()
print("Warte auf Satelliten-Signal...")

while true do
    -- Wartet auf die Daten von der Turtle
    local id, msg, prot = rednet.receive("SAT_UPDATE")
    
    if msg and type(msg) == "table" then
        updateScreen(msg)
    end
end
